#!/bin/bash
set -eufo pipefail
{{- $profileBrewfile := printf "Brewfile.%s" .profile }}
{{- $hasProfileBrewfile := stat (joinPath .chezmoi.sourceDir $profileBrewfile) }}
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
{{- if $hasProfileBrewfile }}
# {{ $profileBrewfile }} hash: {{ include $profileBrewfile | sha256sum }}
{{- end }}

# Each script runs in its own process, so the PATH from 01-install-homebrew
# is not inherited: always call brew by absolute path.
brew=/opt/homebrew/bin/brew

echo "==> Installing packages from Brewfile..."
"$brew" bundle install --file="{{ .chezmoi.sourceDir }}/Brewfile"
{{- if $hasProfileBrewfile }}

echo "==> Installing {{ .profile }} packages from {{ $profileBrewfile }}..."
"$brew" bundle install --file="{{ joinPath .chezmoi.sourceDir $profileBrewfile }}"
{{- end }}
