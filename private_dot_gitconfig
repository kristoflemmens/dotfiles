[init]
	defaultBranch = main
	templateDir = ~/.git-template
[core]
	editor = "code --new-window --wait"
	autocrlf = input
	pager = 
	excludesfile = ~/.gitignore
[alias]
	tags = "tag -l"
	branches = "branch -a"
	remotes = "remote -v"
	worktrees = "worktree list -vv"
	prune-branches = "!f(){ tmp=$(mktemp) && git worktree list --porcelain | awk '/^branch /{sub(\"^refs/heads/\", \"\", $2); print $2}' | sort -u > \"$tmp\" && git remote prune origin && git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads/ | awk '$2 ~ /gone/ { print $1 }' | grep -vxFf \"$tmp\" | xargs -r -n 1 git branch -d; rm -f \"$tmp\"; }; f"
[merge]
	tool = "code"
[mergetool "code"]
	cmd = "code -n -w $MERGED"
[diff]
	tool = "code"
[difftool]
	prompt = false
[difftool "code"]
	cmd = "code -n -w --diff $LOCAL $REMOTE"
	trustExitCode = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[diff "ansible-vault"]
	textconv = ansible-vault view
	cachetextconv = false
[pull]
	rebase = true
[user]
	name = Kristof Lemmens
	# Fallback identity used everywhere commit.gpgsign is enabled below,
	# except where overridden by a private work overlay's includeIf blocks
	# for specific work project trees. Without this, any repo outside
	# those specific directories (e.g. an ad-hoc clone, or
	# ~/.local/share/chezmoi itself) has no signingkey configured, and
	# `commit.gpgsign = true` below causes:
	#   fatal: either user.signingkey or gpg.ssh.defaultKeyCommand needs
	#   to be configured
	email = kristof@klconsultancy.be
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIgSPYSZafVtcwwEBFpzzrjsl+zGGcVAj36Z7nModaSq
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[include]
	# Optional work overlay hook: if a private overlay repo creates this file,
	# git will load additional includeIf rules from it (for work identities,
	# signing keys, etc.). Keeping this reference in the base config avoids
	# requiring any post-apply mutation of ~/.gitconfig by other repos.
	path = ~/.config/work-overlay/gitconfig/includeif-work.conf
