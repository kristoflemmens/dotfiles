#!/bin/bash
set -euo pipefail
# (Re)loads every com.kristoflemmens.dotfiles.* LaunchAgent: this repo's
# (.chezmoidata.yaml) and any an overlay installs (overlays apply first).
# plist template hash: {{ include ".chezmoitemplates/launchagent.plist" | sha256sum }}
# agents: {{ range .launchAgents }}{{ .name }} {{ end }}
{{- range glob (joinPath .chezmoi.homeDir "Library/LaunchAgents/com.kristoflemmens.dotfiles.*.plist") }}
# {{ base . }} hash: {{ include . | sha256sum }}
{{- end }}

logs="${HOME}/.local/state/dotfiles/logs"
mkdir -p "$logs"
# Logs used to live in ~/.local/share/chezmoi-logs, which looked like an
# overlay source; move what is left there to the Trash.
old="${HOME}/.local/share/chezmoi-logs"
if [ -d "$old" ]; then
  mv "$old" "${HOME}/.Trash/chezmoi-logs-$(date +%Y%m%d%H%M%S)"
fi
domain="gui/$(id -u)"

for plist in "${HOME}"/Library/LaunchAgents/com.kristoflemmens.dotfiles.*.plist; do
  [ -f "$plist" ] || continue
  label="$(basename "$plist" .plist)"
  echo "==> (Re)loading LaunchAgent ${label}..."
  launchctl bootout "${domain}/${label}" >/dev/null 2>&1 || true
  launchctl bootstrap "${domain}" "$plist"
done
