"$schema" = 'https://starship.rs/config-schema.json'

# Official "tokyo-night" preset (starship preset tokyo-night) on the left:
# os, directory, git, languages. On the right, on the input line: last exit
# status, command duration, terraform workspace, Azure subscription, kube
# context and the clock.
#
# A template: the overlay's ~/.config/dotfiles-overlay/starship.toml is
# appended. It may only add tables this file doesn't define (TOML allows a
# table once). `chezmoi edit` works; `chezmoi re-add` would flatten it.

format = """
[░▒▓](#a3aed2)\
$os\
[](bg:#769ff0 fg:#a3aed2)\
$directory\
[](fg:#769ff0 bg:#394260)\
$git_branch\
$git_state\
$git_status\
[](fg:#394260 bg:#212736)\
$nodejs\
$bun\
$python\
$rust\
$golang\
$php\
[ ](fg:#212736)\
\n$character"""

right_format = """
[](fg:#1d2230)\
$status\
$cmd_duration\
$terraform\
$azure\
$kubernetes\
$time\
[▓▒░](fg:#1d2230)"""

[character]
success_symbol = "[❯](bold #9ece6a)"
error_symbol = "[❯](bold #f7768e)"

[directory]
style = "fg:#e3e5e5 bg:#769ff0"
format = "[ $path ]($style)[$read_only]($read_only_style)"
# Inside a repo: the repo root in bold, the path below it in full up to
# truncation_length dirs, nothing above it.
repo_root_style = "bold fg:#ffffff bg:#769ff0"
repo_root_format = "[ $before_root_path]($before_repo_root_style)[$repo_root]($repo_root_style)[$path ]($style)[$read_only]($read_only_style)"
before_repo_root_style = "fg:#c0caf5 bg:#769ff0"
truncation_length = 4
truncation_symbol = "…/"
read_only = " 󰌾 "
read_only_style = "fg:#f7768e bg:#769ff0"

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = " "
"Pictures" = " "

[git_branch]
symbol = ""
style = "bg:#394260"
format = '[[ $symbol $branch(:$remote_branch) ](fg:#769ff0 bg:#394260)]($style)'
only_attached = false

[git_state]
style = "bg:#394260"
format = '[[$state( $progress_current/$progress_total) ](bold fg:#e0af68 bg:#394260)]($style)'

# Counts per kind, coloured: green staged, yellow modified, red conflicts and
# deletions, grey untracked/stash, blue ahead/behind.
[git_status]
style = "bg:#394260"
format = '[($conflicted$staged$modified$renamed$deleted$untracked$stashed$ahead_behind )]($style)'
conflicted = '[ =$count](bold fg:#f7768e bg:#394260)'
staged = '[ +$count](fg:#9ece6a bg:#394260)'
modified = '[ !$count](fg:#e0af68 bg:#394260)'
renamed = '[ »$count](fg:#e0af68 bg:#394260)'
deleted = '[ ✘$count](fg:#f7768e bg:#394260)'
untracked = '[ ?$count](fg:#a9b1d6 bg:#394260)'
stashed = '[ ≡$count](fg:#a9b1d6 bg:#394260)'
ahead = '[ ⇡$count](fg:#7dcfff bg:#394260)'
behind = '[ ⇣$count](fg:#7dcfff bg:#394260)'
diverged = '[ ⇡$ahead_count⇣$behind_count](bold fg:#7dcfff bg:#394260)'
up_to_date = ''

[nodejs]
symbol = ""
style = "bg:#212736"
format = '[[ $symbol ($version) ](fg:#769ff0 bg:#212736)]($style)'

[bun]
symbol = ""
style = "bg:#212736"
format = '[[ $symbol ($version) ](fg:#769ff0 bg:#212736)]($style)'

[python]
symbol = ""
style = "bg:#212736"
format = '[[ $symbol ($version)( \($virtualenv\)) ](fg:#769ff0 bg:#212736)]($style)'

[rust]
symbol = ""
style = "bg:#212736"
format = '[[ $symbol ($version) ](fg:#769ff0 bg:#212736)]($style)'

[golang]
symbol = ""
style = "bg:#212736"
format = '[[ $symbol ($version) ](fg:#769ff0 bg:#212736)]($style)'

[php]
symbol = ""
style = "bg:#212736"
format = '[[ $symbol ($version) ](fg:#769ff0 bg:#212736)]($style)'

[os]
style = "bg:#a3aed2 fg:#090c0c"
format = "[ $symbol ]($style)"
disabled = false

[os.symbols]
Windows = "󰍲"
Ubuntu = "󰕈"
SUSE = ""
Raspbian = "󰐿"
Mint = "󰣭"
Macos = "󰀵"
Manjaro = ""
Linux = "󰌽"
Gentoo = "󰣨"
Fedora = "󰣛"
Alpine = ""
Amazon = ""
Android = ""
AOSC = ""
Arch = "󰣇"
Artix = "󰣇"
EndeavourOS = ""
CentOS = ""
Debian = "󰣚"
Redhat = "󱄛"
RedHatEnterprise = "󱄛"
Pop = ""

# --- Right side (bg #1d2230) ---

[status]
disabled = false
symbol = "✘ "
format = '[ $symbol$status( $signal_name) ]($style)'
style = "bold bg:#1d2230 fg:#f7768e"

[cmd_duration]
min_time = 2000
format = '[ ⏱ $duration ]($style)'
style = "bg:#1d2230 fg:#e0af68"

[terraform]
symbol = "󱁢"
format = '[ $symbol $workspace ]($style)'
style = "bg:#1d2230 fg:#bb9af7"

# $azure is in right_format but off by default: an overlay that wants it
# defines [azure] in its fragment (style "bg:#1d2230 ..." to fit in).

[kubernetes]
disabled = false
format = '[ ⎈ $context( \($namespace\)) ]($style)'
style = "bg:#1d2230 fg:#7aa2f7"

# Production in red, acceptance in yellow: matched on the context name.
[[kubernetes.contexts]]
context_pattern = ".*prod.*"
style = "bold bg:#1d2230 fg:#f7768e"

[[kubernetes.contexts]]
context_pattern = ".*(acc|stag).*"
style = "bg:#1d2230 fg:#e0af68"

[time]
disabled = false
time_format = "%R" # Hour:Minute Format
style = "bg:#1d2230"
format = '[[  $time ](fg:#a0a9cb bg:#1d2230)]($style)'
{{- $fragment := joinPath .chezmoi.homeDir ".config/dotfiles-overlay/starship.toml" }}
{{- if stat $fragment }}

# --- From the overlay (~/.config/dotfiles-overlay/starship.toml) ---
{{ include $fragment | trim }}
{{- end }}
