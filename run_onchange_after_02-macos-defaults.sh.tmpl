#!/bin/bash
set -eufo pipefail
# defaults data hash: {{ include "macos-defaults.tsv" | sha256sum }}

echo "==> Applying macOS system defaults..."

DEFAULTS_FILE="{{ .chezmoi.sourceDir }}/macos-defaults.tsv"

while IFS='|' read -r flag domain key type value; do
  # skip blank lines and comments
  [ -z "$domain" ] && continue
  case "$domain" in \#*) continue ;; esac

  # shellcheck disable=SC2086
  defaults $flag write "$domain" "$key" "-$type" "$value"
done < <(grep -v '^\s*#' "$DEFAULTS_FILE" | grep -v '^\s*$')

# --- Screenshots (not tracked in macos-defaults.tsv: path depends on $HOME) ---
mkdir -p "${HOME}/Documents/Screenshots"
defaults write com.apple.screencapture location -string "${HOME}/Documents/Screenshots"

# Restart affected apps so changes take effect. Restart the Dock through
# launchd: after a plain `killall Dock` it isn't always relaunched, which
# leaves you without Dock, Mission Control and trackpad swipes.
launchctl kickstart -k "gui/$(id -u)/com.apple.Dock.agent" >/dev/null 2>&1 || killall Dock >/dev/null 2>&1 || true
pgrep -qx Dock || open -a Dock
killall Finder >/dev/null 2>&1 || true

echo "==> macOS defaults applied. Some settings may require a logout/restart."
