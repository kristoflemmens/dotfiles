#!/bin/bash
set -eufo pipefail
# LaunchAgent plist hash: {{ include "private_Library/LaunchAgents/com.kristoflemmens.dotfiles.sync-macos-defaults.plist.tmpl" | sha256sum }}

PLIST="${HOME}/Library/LaunchAgents/com.kristoflemmens.dotfiles.sync-macos-defaults.plist"
LABEL="com.kristoflemmens.dotfiles.sync-macos-defaults"

mkdir -p "${HOME}/.local/share/chezmoi-logs"

echo "==> (Re)loading LaunchAgent ${LABEL}..."
launchctl unload "$PLIST" >/dev/null 2>&1 || true
launchctl load -w "$PLIST"
echo "==> LaunchAgent loaded. It will run bin/sync-macos-defaults.sh at login and every 4 hours."
