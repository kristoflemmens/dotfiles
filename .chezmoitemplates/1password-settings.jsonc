// 1Password app settings every Mac gets. The modify_ template in
// Library/Group Containers/.../1Password/Data/settings lays these over
// settings.json, then the overlay's ~/.config/dotfiles-overlay/1password-settings.jsonc.
// 1Password rewrites the file in its own key order and keeps state in it
// (unlock times, dismissed banners), so only preferences go here. Apply with
// 1Password quit: the running app can write its own values back.
{
  "sshAgent.enabled": true,
  "sshAgent.sshAuthorizatonModel": "application",
  "sshAgent.storeKeyTitles": true,
  "developers.cliSharedLockState.enabled": true,
  "security.autolock.minutes": 60,
  "keybinds.quickAccess": "CmdOrCtrl+Alt+\\",
  "browsers.extension.enabled": true,
  "appearance.interfaceDensity": "compact"
}
