# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# oh-my-zsh and third-party plugins are installed by chezmoi
# (.chezmoiexternal.toml). Own plugins live in ~/.config/oh-my-zsh-custom.
export ZSH="$HOME/.oh-my-zsh"
ZSH_CUSTOM="$HOME/.config/oh-my-zsh-custom"

# Skip oh-my-zsh's compaudit permission-scan of every directory in $fpath on
# every shell startup. This was measured to be ~90% of total .zshrc load time
# (compinit -> compaudit + compdump). Safe here: this is a single-user
# machine and $fpath only contains Homebrew/oh-my-zsh paths we trust.
ZSH_DISABLE_COMPFIX="true"

# Prompt comes from powerlevel10k below; updates come from chezmoi externals.
ZSH_THEME=""
zstyle ':omz:update' mode disabled

CASE_SENSITIVE="true"
HIST_STAMPS="yyyy-mm-dd"

plugins=(
        1password
        alias-finder
        bkt
        brew
        eza
        gh
        git
        git-auto-fetch
        gnu-utils
        helm
        herdr
        kubectl
        macos
        prek
        terraform
        vscode
        wd
        web-search
        zsh-autosuggestions
        zsh-bat
        zsh-syntax-highlighting
        )

# Overlay hook for extra plugins, appended before oh-my-zsh loads.
[[ -f ~/.config/dotfiles-overlay/zsh/plugins.zsh ]] && source ~/.config/dotfiles-overlay/zsh/plugins.zsh

# Drop plugins that aren't installed on this machine instead of letting
# oh-my-zsh print a warning on every shell start.
() {
  local p
  local -a installed
  for p in $plugins; do
    [[ -d $ZSH_CUSTOM/plugins/$p || -d $ZSH/plugins/$p ]] && installed+=($p)
  done
  plugins=($installed)
}

fpath=("$ZSH_CUSTOM/plugins/zsh-completions/src" "$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
source "$ZSH/oh-my-zsh.sh"

alias watch='watch '
# grg/fnd are optional wrappers in ~/.local/bin; only alias when present.
(( $+commands[grg] )) && alias grep='grg'
(( $+commands[fnd] )) && alias find='fnd'

source "$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme"
[[ -f ~/.config/dotfiles-overlay/zsh/zshrc.zsh ]] && source ~/.config/dotfiles-overlay/zsh/zshrc.zsh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

[[ "$TERM_PROGRAM" == "vscode" ]] && . "$(code --locate-shell-integration-path zsh)"
