# Interactive zsh without a framework. PATH is set in ~/.zshenv; plugins
# (incl. the oh-my-zsh git/kubectl/brew/eza alias sets) are loaded by antidote
# from ~/.config/zsh/plugins.txt.

# GNU tools first in interactive shells (what oh-my-zsh's gnu-utils did);
# scripts keep the macOS versions.
path=("$HOMEBREW_PREFIX"/opt/{coreutils,findutils,gnu-sed,gnu-tar,grep}/libexec/gnubin(N) $path)

# --- History ---
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=10000
setopt extended_history hist_expire_dups_first hist_ignore_dups \
  hist_ignore_space hist_verify share_history
alias history='fc -li 1'

# --- Navigation and editing ---
setopt auto_cd auto_pushd pushd_ignore_dups pushd_minus interactive_comments
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search '^[OB' down-line-or-beginning-search
bindkey '^[[H' beginning-of-line '^[[F' end-of-line
bindkey '^[[1;3D' backward-word '^[[1;3C' forward-word   # option-arrows
bindkey '^[[1;5D' backward-word '^[[1;5C' forward-word   # ctrl-arrows
bindkey '^[[3~' delete-char

# --- Completion ---
export ZSH_CACHE_DIR="$HOME/.cache/zsh"   # used by the kubectl alias plugin
[[ -d $ZSH_CACHE_DIR/completions ]] || mkdir -p "$ZSH_CACHE_DIR/completions"
fpath=("$ZSH_CACHE_DIR/completions" "$HOMEBREW_PREFIX/share/zsh-completions"
  "$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
autoload -Uz compinit
# -u: Homebrew leaves /opt/homebrew/share group-writable, which compaudit
# flags; on this single-user Mac that's fine (oh-my-zsh's ZSH_DISABLE_COMPFIX).
# Rebuild the dump at most once a day; otherwise reuse it (-C).
stale=("$ZSH_CACHE_DIR"/zcompdump(N.mh+24))
if (( $#stale )) || [[ ! -f $ZSH_CACHE_DIR/zcompdump ]]; then
  compinit -u -d "$ZSH_CACHE_DIR/zcompdump"
else
  compinit -u -C -d "$ZSH_CACHE_DIR/zcompdump"
fi
unset stale
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# --- Plugins (antidote; list in ~/.config/zsh/plugins.txt) ---
# The bundle is regenerated only when a plugin list changes.
source "$HOMEBREW_PREFIX/opt/antidote/share/antidote/antidote.zsh"
plugin_lists=(~/.config/zsh/plugins.txt ~/.config/dotfiles-overlay/zsh/plugins.txt(N))
plugin_bundle="$ZSH_CACHE_DIR/plugins.zsh"
for f in $plugin_lists; do
  if [[ ! -s $plugin_bundle || $f -nt $plugin_bundle ]]; then
    cat $plugin_lists | antidote bundle >| "$plugin_bundle"
    break
  fi
done
source "$plugin_bundle"
unset plugin_lists plugin_bundle f

# --- Aliases ---
alias l='ls -lah'
alias cat='bat --paging=never'
alias watch='watch '
# grg/fnd are optional wrappers in ~/.local/bin; only alias when present.
(( $+commands[grg] )) && alias grep='grg'
(( $+commands[fnd] )) && alias find='fnd'

# --- Tools ---
eval "$(zoxide init zsh)"
eval "$(starship init zsh)"

# Optional overlay hook (e.g. a private work overlay).
[[ -f ~/.config/dotfiles-overlay/zsh/zshrc.zsh ]] && source ~/.config/dotfiles-overlay/zsh/zshrc.zsh

[[ "$TERM_PROGRAM" == "vscode" ]] && . "$(code --locate-shell-integration-path zsh)"
