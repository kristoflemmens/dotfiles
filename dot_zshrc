# Interactive zsh without a framework. PATH is set in ~/.zshenv; plugins,
# zoxide and the Starship prompt are loaded by antidote from
# ~/.config/zsh/plugins.txt.

# --- History ---
HISTFILE=~/.local/state/zsh/history
[[ -d ${HISTFILE:h} ]] || mkdir -p "${HISTFILE:h}"
# Move the old ~/.zsh_history here. Shells started before the move keep
# appending to it (recreating it with only their new commands), so each new
# shell folds whatever is there in and moves the leftover to the Trash.
if [[ -f ~/.zsh_history ]]; then
  if [[ -e $HISTFILE ]]; then
    command cat ~/.zsh_history >> $HISTFILE
    if [[ $OSTYPE == darwin* ]]; then
      mv ~/.zsh_history ~/.Trash/zsh_history-$(date +%Y%m%d%H%M%S)
    else
      command rm ~/.zsh_history
    fi
  else
    mv ~/.zsh_history $HISTFILE
  fi
fi
HISTSIZE=50000
SAVEHIST=10000
setopt extended_history hist_expire_dups_first hist_ignore_dups \
  hist_ignore_space hist_verify share_history
alias history='fc -l -t "%Y/%m/%d %H:%M:%S" 1'   # all entries, with date and time

# --- Navigation and editing ---
setopt auto_cd auto_pushd pushd_ignore_dups pushd_minus interactive_comments
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search '^[OB' down-line-or-beginning-search
# Home/End (fn-arrows, external keyboards); Ghostty sends cmd-arrows as ^A/^E.
bindkey '^[[H' beginning-of-line '^[[F' end-of-line
bindkey '^[[1;3D' backward-word '^[[1;3C' forward-word   # option-arrows
bindkey '^[[3~' delete-char

# --- Completion ---
export ZSH_CACHE_DIR="$HOME/.cache/zsh"   # used by the kubectl alias plugin
[[ -d $ZSH_CACHE_DIR/completions ]] || mkdir -p "$ZSH_CACHE_DIR/completions"
fpath=("$ZSH_CACHE_DIR/completions" "$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
autoload -Uz compinit
# -u: Homebrew leaves /opt/homebrew/share group-writable, which compaudit
# flags; on this single-user Mac that's fine (oh-my-zsh's ZSH_DISABLE_COMPFIX).
# Rebuild the dump at most once a day; otherwise reuse it (-C).
stale=("$ZSH_CACHE_DIR"/zcompdump(N.mh+24))
if (( $#stale )) || [[ ! -f $ZSH_CACHE_DIR/zcompdump ]]; then
  compinit -u -d "$ZSH_CACHE_DIR/zcompdump"
else
  compinit -u -C -d "$ZSH_CACHE_DIR/zcompdump"
fi
unset stale
zstyle ':completion:*' menu select
zstyle ':completion:*' cache-path "$ZSH_CACHE_DIR/zcompcache"   # default: ~/.zcompcache
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# --- Plugins (antidote; list in ~/.config/zsh/plugins.txt) ---
# The bundle is regenerated only when a plugin list changes.
source "$HOMEBREW_PREFIX/opt/antidote/share/antidote/antidote.zsh"
plugin_lists=(~/.config/zsh/plugins.txt ~/.config/dotfiles-overlay/zsh/plugins.txt(N))
plugin_bundle="$ZSH_CACHE_DIR/plugins.zsh"
for f in $plugin_lists; do
  if [[ ! -s $plugin_bundle || $f -nt $plugin_bundle ]]; then
    cat $plugin_lists | antidote bundle >| "$plugin_bundle"
    break
  fi
done
source "$plugin_bundle"
unset plugin_lists plugin_bundle f

# --- Aliases ---
alias l='ls -lah'
alias cat='bat'   # pages only when output exceeds the screen and goes to the terminal
alias watch='watch '
alias wd='cd'     # old wd bookmark habit; cd jumps through zoxide
alias top='btop'
# duf is always human-readable and has no -h; drop it so `df -h` still works.
df() { duf "${@:#-h}" }
# doggo reads dig's `name type @server` and -x; +short becomes --short. Other
# +options (+trace, +noall, ...) go to the real dig, which doggo doesn't mimic.
dig() {
  local a args=()
  for a; do
    case $a in
      +short) args+=(--short) ;;
      +*) command dig "$@"; return ;;
      *) args+=("$a") ;;
    esac
  done
  doggo "${args[@]}"
}
# Pager options for less (bat, delta and man use it too): pass colours through.
export LESS='-R'
# Highlight with bat: `<cmd> --help` (global alias, only what's typed here)
# and man pages (col -bx strips man's overstrike bold). The help pager waits
# for the command to finish: some (`claude`) still touch the terminal while
# exiting, which leaves less deaf to arrow keys and scrolling.
_help_pager() {
  local text
  text=$(command cat)   # the real cat, not the bat alias
  print -r -- "$text" | bat --language=help --style=plain
}
alias -g -- --help='--help 2>&1 | _help_pager'
export MANPAGER="sh -c 'col -bx | bat --language=man --style=plain'"

# --- Dotfiles ---
# Every overlay (own config in ~/.config/chezmoi-*/) first, then this repo:
# its templates include fragments the overlays install.
dotfiles-apply() {
  local config
  for config in ~/.config/chezmoi-*/chezmoi.yaml(N); do
    chezmoi --config "$config" apply || return
  done
  chezmoi apply "$@"
}
dotfiles-update() {
  local config
  for config in ~/.config/chezmoi-*/chezmoi.yaml(N); do
    chezmoi --config "$config" git pull -- --rebase || return
  done
  chezmoi git pull -- --rebase || return
  dotfiles-apply "$@"
}

# Optional overlay hook (e.g. a private work overlay).
[[ -f ~/.config/dotfiles-overlay/zsh/zshrc.zsh ]] && source ~/.config/dotfiles-overlay/zsh/zshrc.zsh
