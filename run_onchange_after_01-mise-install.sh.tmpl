#!/bin/bash
set -eufo pipefail
# dot_config/mise/config.toml hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

echo "==> Installing runtimes via mise (from ~/.config/mise/config.toml)..."
if command -v mise >/dev/null 2>&1; then
  mise install
else
  echo "mise not found on PATH yet, skipping (it will be available after shell restart)."
fi
