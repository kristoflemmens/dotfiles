#!/bin/bash
set -eufo pipefail
# tool-versions hash: {{ include "dot_tool-versions" | sha256sum }}

echo "==> Installing runtimes via mise (from ~/.tool-versions)..."
if command -v mise >/dev/null 2>&1; then
  mise install
else
  echo "mise not found on PATH yet, skipping (it will be available after shell restart)."
fi
