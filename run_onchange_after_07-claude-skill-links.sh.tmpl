#!/bin/bash
set -euo pipefail
# Link the skills in ~/.agents/skills/ (own ones from chezmoi sources, APM's
# from run_onchange_after_06) into ~/.claude/skills/. Runs when the set of
# skills changes; skills added in this same apply are linked on the next one,
# or by running bin/link-claude-skills.sh.
# skills: {{ range glob (joinPath .chezmoi.homeDir ".agents/skills/*") }}{{ base . }} {{ end }}
# source skills: {{ range glob (joinPath .chezmoi.sourceDir "dot_agents/skills/*") }}{{ base . }} {{ end }}

"{{ .chezmoi.sourceDir }}/bin/link-claude-skills.sh"
