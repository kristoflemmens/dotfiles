{{- /* Generates ~/.config/chezmoi/chezmoi.yaml on `chezmoi init`.
       Asked once and remembered; override with
       `chezmoi init --promptBool "Personal Mac=false"`.
       Work-specific config never lives here: it comes from a private
       overlay repo (see README). */ -}}
{{- $personal := promptBoolOnce . "personal" "Personal Mac" -}}
data:
  personal: {{ $personal }}
diff:
  pager: delta
  exclude:
    - scripts
edit:
  command: code
  args:
    - --new-window
    - --wait
merge:
  command: bash
  args:
    - -c
    # Raw string: the inner .Target/.Source placeholders are evaluated at merge time, not at init.
    - {{ `cp {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} {{ .Source | quote }}` | quote }}
