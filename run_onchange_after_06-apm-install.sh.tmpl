#!/bin/bash
set -euo pipefail
# Install the third-party skills in ~/.apm/apm.yml into ~/.agents/skills/
# (and remove those no longer listed), then link them for Claude Code.
# Runs when a dependency list changes.
# shared apm-deps.yaml hash: {{ includeTemplate "apm-deps.yaml" . | sha256sum }}
{{- $overlay := joinPath .chezmoi.homeDir ".config/dotfiles-overlay/apm-deps.yaml" }}
# overlay apm-deps.yaml hash: {{ if stat $overlay }}{{ include $overlay | sha256sum }}{{ end }}

if ! command -v apm >/dev/null; then
  echo "apm not installed (Brewfile): skipping agent skills" >&2
  exit 0
fi
apm install --global
"{{ .chezmoi.sourceDir }}/bin/link-claude-skills.sh"
