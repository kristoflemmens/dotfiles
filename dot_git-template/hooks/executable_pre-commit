#!/usr/bin/env bash
# Default pre-commit hook for every new clone (init.templateDir). Runs prek
# (or pre-commit) only when the repo has a .pre-commit-config.yaml.

[ -f .pre-commit-config.yaml ] || exit 0

for runner in prek pre-commit; do
  if command -v "$runner" >/dev/null 2>&1; then
    exec "$runner" hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit \
      --skip-on-missing-config --hook-dir "$(cd "$(dirname "$0")" && pwd)" -- "$@"
  fi
done

echo 'prek/pre-commit not found, but a .pre-commit-config.yaml exists. Skipping hook.' >&2
